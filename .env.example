VIDEO_WORKER_URL=http://localhost:8000
VIDEO_WORKER_SECRET=replace-with-a-long-random-secret
# Local worker: allow finished videos of any duration and size, with up to 24 hours to prepare.
VIDEO_MAX_DURATION_SECONDS=0
VIDEO_MAX_FILESIZE_MB=0
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=86400
# On Vercel, set only VIDEO_WORKER_SECRET. vercel.json injects VIDEO_WORKER_INTERNAL_URL.
